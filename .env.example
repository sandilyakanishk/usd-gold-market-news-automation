# Copy to .env and adjust. Every value is optional; the defaults are shown.
# .env is ignored by Git. Never commit real credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite   -> local development and tests (default, needs nothing else)
# postgres -> production (Supabase or any PostgreSQL); requires DATABASE_URL
DATABASE_BACKEND=sqlite

# Local SQLite file, used when DATABASE_BACKEND=sqlite and as the source of
# --migrate-to-postgres.
SQLITE_PATH=data/events.db

# PostgreSQL connection string, used when DATABASE_BACKEND=postgres.
# For Supabase, copy it from the project's "Connect" panel and put your
# database password in place of [YOUR-PASSWORD]. Form:
#   postgresql://USER:PASSWORD@HOST:PORT/postgres
# This value is a secret. In the cloud, set it as a secret environment
# variable instead of using a file.
DATABASE_URL=

# Seconds to wait for the PostgreSQL connection before giving up.
DB_CONNECT_TIMEOUT_SECONDS=10

# Calendar events older than this many days are deleted (minimum 1).
CALENDAR_RETENTION_DAYS=14

# "This was sent" records older than this many days are deleted (market pulse
# records after 2 days). Never applied below CALENDAR_RETENTION_DAYS + 1.
DELIVERY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Forex Factory collector
# ---------------------------------------------------------------------------
# Forex Factory's official weekly calendar export. No API key is needed.
FF_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# IANA timezone used for the stored date/time, for "today", and for the
# retention cutoff. Leave empty to keep the UTC offset the feed provides.
DISPLAY_TIMEZONE=Asia/Kolkata

# Minimum seconds between real downloads. Forex Factory allows 2 per 5 minutes
# and refreshes the file about hourly, so there is no benefit in going lower.
MIN_FETCH_INTERVAL_SECONDS=1800

REQUEST_TIMEOUT_SECONDS=20

RAW_CACHE_PATH=data/raw/ff_calendar_thisweek.json
GOLD_RELEVANCE_CONFIG=config/gold_relevance.json

# Step 2 classification rules (Gold relevance level, category, priority).
GOLD_PRIORITY_RULES=config/gold_priority_rules.json
LOG_PATH=logs/collector.log
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Actual results (Step 3)
# ---------------------------------------------------------------------------
# Which official series supplies the Actual of which Forex Factory event.
ACTUAL_EVENT_MAPPING=config/actual_event_mapping.json

# U.S. Bureau of Labor Statistics. Optional: works without a key (25 requests
# a day); a free registration key raises that to 500. Secret.
BLS_API_KEY=

# FRED, Federal Reserve Bank of St. Louis. Free key from
# https://fred.stlouisfed.org/docs/api/api_key.html . Needed for PCE, GDP,
# retail sales, jobless claims and the Fed funds target. Secret.
FRED_API_KEY=

# Stop asking a source about an unpublished release after this many days.
ACTUALS_RETRY_DAYS=7

# ---------------------------------------------------------------------------
# Message content (Step 4) -- text generation only, nothing is sent
# ---------------------------------------------------------------------------
MESSAGE_TEMPLATES=config/message_templates.json
HEADLINE_RULES=config/headline_rules.json
PREVIEW_FIXTURE=fixtures/message_preview_events.json

# ---------------------------------------------------------------------------
# WhatsApp delivery (Step 5) -- via Whapi.Cloud
# ---------------------------------------------------------------------------
# Channel token from the Whapi dashboard. Secret.
WHAPI_TOKEN=

# The WhatsApp Community and its Announcements group, as "<digits>@g.us".
# Messages are sent to the announcement chat; the community id lets
# --whatsapp-check confirm the two belong together.
WHATSAPP_COMMUNITY_ID=
WHATSAPP_ANNOUNCEMENT_CHAT_ID=

WHAPI_BASE_URL=https://gate.whapi.cloud

# ---------------------------------------------------------------------------
# Telegram delivery -- optional, via the Bot API
# ---------------------------------------------------------------------------
# Bot token from @BotFather. Secret.
TELEGRAM_BOT_TOKEN=

# The channel the bot posts to: "@channelname" for a public channel, or the
# numeric id (starting with -100) for a private one. The bot must be an
# administrator of the channel with permission to post.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
# Set to run the storage tests against a real PostgreSQL server as well
# (direct or session-mode connection). They use a temporary schema.
# TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Market pulse -- half-hourly gold price post (Telegram only)
# ---------------------------------------------------------------------------
# Free XAU/USD quote, no key needed. Must answer JSON with "price" and "updatedAt".
GOLD_PRICE_URL=https://api.gold-api.com/price/XAU

# ---------------------------------------------------------------------------
# Video forwarding -- new YouTube Shorts to Telegram
# ---------------------------------------------------------------------------
# Your channel's id (starts with UC, 24 characters). Empty = feature off.
YOUTUBE_CHANNEL_ID=
# shorts = only Shorts; all = also long videos and live streams.
YOUTUBE_FORWARD=shorts
# Uploads published before this moment are never forwarded.
VIDEO_POSTS_SINCE=2026-10-08T00:00:00Z
# Optional: your Instagram profile, shown under every forwarded video.
INSTAGRAM_PROFILE_URL=
